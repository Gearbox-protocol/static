{
  "name": "@gearbox-protocol/static",
  "version": "1.0.0",
  "description": "Static files for gearbox services",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gearbox-protocol/static.git"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.cjs"
    },
    "./static": {
      "types": "./dist/types/static/index.d.ts",
      "import": "./dist/esm/static/index.js",
      "default": "./dist/cjs/static/index.cjs"
    },
    "./migration": {
      "types": "./dist/types/migration/index.d.ts",
      "import": "./dist/esm/migration/index.js",
      "default": "./dist/cjs/migration/index.cjs"
    },
    "./strategies": {
      "types": "./dist/types/strategies/index.d.ts",
      "import": "./dist/esm/strategies/index.js",
      "default": "./dist/cjs/strategies/index.cjs"
    },
    "./pools": {
      "types": "./dist/types/pools/index.d.ts",
      "import": "./dist/esm/pools/index.js",
      "default": "./dist/cjs/pools/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "compile": "tsdown",
    "dev": "tsdown && pnpm generate-configs:ts",
    "clean": "rm -rf ./dist",
    "build": "pnpm compile && pnpm generate-configs:ts",
    "generate-configs:ts": "tsx scripts/generate-configs.ts",
    "fetch-old-borrowers:ts": "tsx scripts/fetch-merge-old-borrowers.ts",
    "fetch-old-accounts:ts": "tsx scripts/fetch-old-accounts-from-borrowers.ts",
    "prepare": "husky",
    "check": "biome check --write",
    "check:ci": "biome check --diagnostic-level=error",
    "typecheck:ci": "tsc --noEmit"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@gearbox-protocol/biome-config": "^1.1.11",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "react": "^19.3.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,json}": [
      "biome check --no-errors-on-unmatched --write"
    ]
  },
  "packageManager": "pnpm@12.21.0"
}
