{
  "name": "@gearbox-protocol/static",
  "version": "1.0.0",
  "description": "Static files for gearbox services",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./static": {
      "types": "./lib/static/index.d.ts",
      "default": "./lib/static/index.js"
    },
    "./migration": {
      "types": "./lib/migration/index.d.ts",
      "default": "./lib/migration/index.js"
    },
    "./strategies": {
      "types": "./lib/strategies/index.d.ts",
      "default": "./lib/strategies/index.js"
    },
    "./pools": {
      "types": "./lib/pools/index.d.ts",
      "default": "./lib/pools/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "compile": "tsc",
    "dev": "tsc && yarn generate-configs:ts",
    "clean": "rm -rf ./lib",
    "build": "yarn compile && yarn generate-configs:ts",
    "generate-configs:ts": "npx ts-node scripts/generate-configs.ts",
    "fetch-old-borrowers:ts": "npx ts-node scripts/fetch-merge-old-borrowers.ts",
    "fetch-old-accounts:ts": "npx ts-node scripts/fetch-old-accounts-from-borrowers.ts",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "prettier:ci": "npx prettier --check .",
    "lint": "eslint . --ext .tsx,.ts --fix",
    "lint:ci": "eslint . --ext .tsx,.ts",
    "typecheck:ci": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@gearbox-protocol/eslint-config": "^2.0.0-next.2",
    "@gearbox-protocol/prettier-config": "^2.0.0",
    "@gearbox-protocol/sdk": "^14.5.2",
    "@types/react": "^19.2.7",
    "eslint": "^8.57.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "react": "^19.2.1",
    "ts-node": "^10.9.2",
    "typescript": "5.0.4"
  },
  "prettier": "@gearbox-protocol/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  },
  "packageManager": "yarn@4.9.2"
}
