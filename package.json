{
  "name": "@gearbox-protocol/static",
  "version": "1.0.0",
  "description": "Static files for gearbox services",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf ./lib",
    "copy-files": "cp -R ./src/assets ./lib",
    "build": "yarn compile && yarn copy-files",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "prettier:ci": "npx prettier --check .",
    "lint": "eslint . --ext .tsx,.ts --fix",
    "lint:ci": "eslint . --ext .tsx,.ts",
    "typecheck:ci": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@gearbox-protocol/eslint-config": "^1.6.1",
    "@gearbox-protocol/prettier-config": "^1.5.0",
    "@types/react": "^18.0.21",
    "eslint": "^8.24.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "react": "^17.0.1",
    "react-feather": "^2.0.10",
    "typescript": "^4.8.4"
  },
  "prettier": "@gearbox-protocol/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  }
}
