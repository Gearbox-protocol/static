{
  "name": "@gearbox-protocol/static",
  "version": "1.0.0",
  "description": "Static files for gearbox services",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "compile": "tsc",
    "dev": "tsc && yarn generate-strategies:ts",
    "clean": "rm -rf ./lib",
    "copy-files": "mkdir -p ./src/assets && cp -R ./src/assets ./lib",
    "build": "yarn compile && yarn generate-strategies:ts && yarn copy-files",
    "generate-strategies:ts": "npx ts-node scripts/generate-strategies.ts",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "prettier:ci": "npx prettier --check .",
    "lint": "eslint . --ext .tsx,.ts --fix",
    "lint:ci": "eslint . --ext .tsx,.ts",
    "typecheck:ci": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@gearbox-protocol/eslint-config": "^2.0.0-next.2",
    "@gearbox-protocol/prettier-config": "^2.0.0",
    "@types/react": "18.2.0",
    "eslint": "^8.57.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "react": "18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "5.0.4"
  },
  "prettier": "@gearbox-protocol/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  }
}
