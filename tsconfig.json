{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ESNext"],
    "types": ["node"],
    "jsx": "react-jsx",
    "declaration": true,
    "removeComments": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "scripts", "tsdown.config.ts"],
  "exclude": ["dist", "node_modules"]
}
